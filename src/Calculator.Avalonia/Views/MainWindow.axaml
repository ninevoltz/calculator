<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Calculator.Avalonia.ViewModels"
        xmlns:controls="using:Calculator.Avalonia.Controls"
        xmlns:models="using:Calculator.Avalonia.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Calculator.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Calculator"
        Width="1120"
        Height="760"
        MinWidth="420"
        MinHeight="560"
        Background="#f3f3f3">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.calc">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.scientific">
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="Button.graphKey">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style Selector="Button.mode">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.digit">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.operator">
            <Setter Property="Background" Value="#f9f9f9"/>
        </Style>
        <Style Selector="Button.equals">
            <Setter Property="Background" Value="#0067c0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
            <TextBlock Text="{Binding Mode}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Classes="mode"
                    Content="Standard"
                    Command="{Binding SetModeCommand}"
                    CommandParameter="Standard"
                    Margin="0,0,6,0"/>
            <Button Grid.Column="2"
                    Classes="mode"
                    Content="Scientific"
                    Command="{Binding SetModeCommand}"
                    CommandParameter="Scientific"/>
            <Button Grid.Column="3"
                    Classes="mode"
                    Content="Programmer"
                    Command="{Binding SetModeCommand}"
                    CommandParameter="Programmer"
                    Margin="6,0,0,0"/>
            <Button Grid.Column="4"
                    Classes="mode"
                    Content="Graphing"
                    Command="{Binding SetModeCommand}"
                    CommandParameter="Graphing"
                    Margin="6,0,0,0"/>
        </Grid>

        <Border Grid.Row="1"
                IsVisible="{Binding IsCalculatorMode}"
                Background="#f7f7f7"
                BorderBrush="#d8d8d8"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding Expression}"
                           FontSize="14"
                           Foreground="#606060"
                           Height="22"
                           HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="1"
                           Text="{Binding Display}"
                           FontSize="44"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid IsVisible="{Binding IsStandard}"
                  RowDefinitions="*,*,*,*,*,*"
                  ColumnDefinitions="*,*,*,*">
                <Button Grid.Row="0" Grid.Column="0" Classes="calc operator" Content="%" Command="{Binding PressCommand}" CommandParameter="%"/>
                <Button Grid.Row="0" Grid.Column="1" Classes="calc operator" Content="CE" Command="{Binding PressCommand}" CommandParameter="CE"/>
                <Button Grid.Row="0" Grid.Column="2" Classes="calc operator" Content="C" Command="{Binding PressCommand}" CommandParameter="C"/>
                <Button Grid.Row="0" Grid.Column="3" Classes="calc operator" Content="⌫" Command="{Binding PressCommand}" CommandParameter="Back"/>

                <Button Grid.Row="1" Grid.Column="0" Classes="calc operator" Content="1/x" Command="{Binding PressCommand}" CommandParameter="Reciprocal"/>
                <Button Grid.Row="1" Grid.Column="1" Classes="calc operator" Content="x²" Command="{Binding PressCommand}" CommandParameter="Square"/>
                <Button Grid.Row="1" Grid.Column="2" Classes="calc operator" Content="√x" Command="{Binding PressCommand}" CommandParameter="Sqrt"/>
                <Button Grid.Row="1" Grid.Column="3" Classes="calc operator" Content="÷" Command="{Binding PressCommand}" CommandParameter="/"/>

                <Button Grid.Row="2" Grid.Column="0" Classes="calc digit" Content="7" Command="{Binding PressCommand}" CommandParameter="7"/>
                <Button Grid.Row="2" Grid.Column="1" Classes="calc digit" Content="8" Command="{Binding PressCommand}" CommandParameter="8"/>
                <Button Grid.Row="2" Grid.Column="2" Classes="calc digit" Content="9" Command="{Binding PressCommand}" CommandParameter="9"/>
                <Button Grid.Row="2" Grid.Column="3" Classes="calc operator" Content="×" Command="{Binding PressCommand}" CommandParameter="*"/>

                <Button Grid.Row="3" Grid.Column="0" Classes="calc digit" Content="4" Command="{Binding PressCommand}" CommandParameter="4"/>
                <Button Grid.Row="3" Grid.Column="1" Classes="calc digit" Content="5" Command="{Binding PressCommand}" CommandParameter="5"/>
                <Button Grid.Row="3" Grid.Column="2" Classes="calc digit" Content="6" Command="{Binding PressCommand}" CommandParameter="6"/>
                <Button Grid.Row="3" Grid.Column="3" Classes="calc operator" Content="-" Command="{Binding PressCommand}" CommandParameter="-"/>

                <Button Grid.Row="4" Grid.Column="0" Classes="calc digit" Content="1" Command="{Binding PressCommand}" CommandParameter="1"/>
                <Button Grid.Row="4" Grid.Column="1" Classes="calc digit" Content="2" Command="{Binding PressCommand}" CommandParameter="2"/>
                <Button Grid.Row="4" Grid.Column="2" Classes="calc digit" Content="3" Command="{Binding PressCommand}" CommandParameter="3"/>
                <Button Grid.Row="4" Grid.Column="3" Classes="calc operator" Content="+" Command="{Binding PressCommand}" CommandParameter="+"/>

                <Button Grid.Row="5" Grid.Column="0" Classes="calc digit" Content="+/-" Command="{Binding PressCommand}" CommandParameter="Sign"/>
                <Button Grid.Row="5" Grid.Column="1" Classes="calc digit" Content="0" Command="{Binding PressCommand}" CommandParameter="0"/>
                <Button Grid.Row="5" Grid.Column="2" Classes="calc digit" Content="." Command="{Binding PressCommand}" CommandParameter="."/>
                <Button Grid.Row="5" Grid.Column="3" Classes="calc equals" Content="=" Command="{Binding PressCommand}" CommandParameter="="/>
            </Grid>

            <Grid IsVisible="{Binding IsScientific}"
                  RowDefinitions="*,*,*,*,*,*,*"
                  ColumnDefinitions="*,*,*,*,*">
                <Button Grid.Row="0" Grid.Column="0" Classes="calc scientific operator" Content="sin" Command="{Binding PressCommand}" CommandParameter="Sin"/>
                <Button Grid.Row="0" Grid.Column="1" Classes="calc scientific operator" Content="cos" Command="{Binding PressCommand}" CommandParameter="Cos"/>
                <Button Grid.Row="0" Grid.Column="2" Classes="calc scientific operator" Content="tan" Command="{Binding PressCommand}" CommandParameter="Tan"/>
                <Button Grid.Row="0" Grid.Column="3" Classes="calc scientific operator" Content="π" Command="{Binding PressCommand}" CommandParameter="Pi"/>
                <Button Grid.Row="0" Grid.Column="4" Classes="calc scientific operator" Content="e" Command="{Binding PressCommand}" CommandParameter="E"/>

                <Button Grid.Row="1" Grid.Column="0" Classes="calc scientific operator" Content="x²" Command="{Binding PressCommand}" CommandParameter="Square"/>
                <Button Grid.Row="1" Grid.Column="1" Classes="calc scientific operator" Content="1/x" Command="{Binding PressCommand}" CommandParameter="Reciprocal"/>
                <Button Grid.Row="1" Grid.Column="2" Classes="calc scientific operator" Content="|x|" Command="{Binding PressCommand}" CommandParameter="Abs"/>
                <Button Grid.Row="1" Grid.Column="3" Classes="calc scientific operator" Content="exp" Command="{Binding PressCommand}" CommandParameter="Exp"/>
                <Button Grid.Row="1" Grid.Column="4" Classes="calc scientific operator" Content="mod" Command="{Binding PressCommand}" CommandParameter="Mod"/>

                <Button Grid.Row="2" Grid.Column="0" Classes="calc scientific operator" Content="√x" Command="{Binding PressCommand}" CommandParameter="Sqrt"/>
                <Button Grid.Row="2" Grid.Column="1" Classes="calc scientific operator" Content="xʸ" Command="{Binding PressCommand}" CommandParameter="Pow"/>
                <Button Grid.Row="2" Grid.Column="2" Classes="calc scientific operator" Content="10ˣ" Command="{Binding PressCommand}" CommandParameter="TenPow"/>
                <Button Grid.Row="2" Grid.Column="3" Classes="calc scientific operator" Content="n!" Command="{Binding PressCommand}" CommandParameter="Factorial"/>
                <Button Grid.Row="2" Grid.Column="4" Classes="calc scientific operator" Content="÷" Command="{Binding PressCommand}" CommandParameter="/"/>

                <Button Grid.Row="3" Grid.Column="0" Classes="calc scientific operator" Content="log" Command="{Binding PressCommand}" CommandParameter="Log"/>
                <Button Grid.Row="3" Grid.Column="1" Classes="calc scientific digit" Content="7" Command="{Binding PressCommand}" CommandParameter="7"/>
                <Button Grid.Row="3" Grid.Column="2" Classes="calc scientific digit" Content="8" Command="{Binding PressCommand}" CommandParameter="8"/>
                <Button Grid.Row="3" Grid.Column="3" Classes="calc scientific digit" Content="9" Command="{Binding PressCommand}" CommandParameter="9"/>
                <Button Grid.Row="3" Grid.Column="4" Classes="calc scientific operator" Content="×" Command="{Binding PressCommand}" CommandParameter="*"/>

                <Button Grid.Row="4" Grid.Column="0" Classes="calc scientific operator" Content="ln" Command="{Binding PressCommand}" CommandParameter="Ln"/>
                <Button Grid.Row="4" Grid.Column="1" Classes="calc scientific digit" Content="4" Command="{Binding PressCommand}" CommandParameter="4"/>
                <Button Grid.Row="4" Grid.Column="2" Classes="calc scientific digit" Content="5" Command="{Binding PressCommand}" CommandParameter="5"/>
                <Button Grid.Row="4" Grid.Column="3" Classes="calc scientific digit" Content="6" Command="{Binding PressCommand}" CommandParameter="6"/>
                <Button Grid.Row="4" Grid.Column="4" Classes="calc scientific operator" Content="-" Command="{Binding PressCommand}" CommandParameter="-"/>

                <Button Grid.Row="5" Grid.Column="0" Classes="calc scientific operator" Content="CE" Command="{Binding PressCommand}" CommandParameter="CE"/>
                <Button Grid.Row="5" Grid.Column="1" Classes="calc scientific digit" Content="1" Command="{Binding PressCommand}" CommandParameter="1"/>
                <Button Grid.Row="5" Grid.Column="2" Classes="calc scientific digit" Content="2" Command="{Binding PressCommand}" CommandParameter="2"/>
                <Button Grid.Row="5" Grid.Column="3" Classes="calc scientific digit" Content="3" Command="{Binding PressCommand}" CommandParameter="3"/>
                <Button Grid.Row="5" Grid.Column="4" Classes="calc scientific operator" Content="+" Command="{Binding PressCommand}" CommandParameter="+"/>

                <Button Grid.Row="6" Grid.Column="0" Classes="calc scientific operator" Content="C" Command="{Binding PressCommand}" CommandParameter="C"/>
                <Button Grid.Row="6" Grid.Column="1" Classes="calc scientific digit" Content="+/-" Command="{Binding PressCommand}" CommandParameter="Sign"/>
                <Button Grid.Row="6" Grid.Column="2" Classes="calc scientific digit" Content="0" Command="{Binding PressCommand}" CommandParameter="0"/>
                <Button Grid.Row="6" Grid.Column="3" Classes="calc scientific digit" Content="." Command="{Binding PressCommand}" CommandParameter="."/>
                <Button Grid.Row="6" Grid.Column="4" Classes="calc scientific equals" Content="=" Command="{Binding PressCommand}" CommandParameter="="/>
            </Grid>

            <Grid IsVisible="{Binding IsProgrammer}"
                  RowDefinitions="Auto,*,*,*,*,*,*,*"
                  ColumnDefinitions="*,*,*,*,*">
                <Grid Grid.Row="0" Grid.ColumnSpan="5" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="54,*" Margin="2,0,2,8">
                    <TextBlock Grid.Row="0" Text="HEX" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProgrammerHex}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="DEC" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProgrammerDec}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Text="OCT" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProgrammerOct}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="3" Text="BIN" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProgrammerBin}" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Button Grid.Row="1" Grid.Column="0" Classes="calc scientific operator" Content="HEX" Command="{Binding PressCommand}" CommandParameter="Hex"/>
                <Button Grid.Row="1" Grid.Column="1" Classes="calc scientific operator" Content="DEC" Command="{Binding PressCommand}" CommandParameter="Dec"/>
                <Button Grid.Row="1" Grid.Column="2" Classes="calc scientific operator" Content="OCT" Command="{Binding PressCommand}" CommandParameter="Oct"/>
                <Button Grid.Row="1" Grid.Column="3" Classes="calc scientific operator" Content="BIN" Command="{Binding PressCommand}" CommandParameter="Bin"/>
                <Button Grid.Row="1" Grid.Column="4" Classes="calc scientific operator" Content="⌫" Command="{Binding PressCommand}" CommandParameter="Back"/>

                <Button Grid.Row="2" Grid.Column="0" Classes="calc scientific operator" Content="A" Command="{Binding PressCommand}" CommandParameter="A"/>
                <Button Grid.Row="2" Grid.Column="1" Classes="calc scientific operator" Content="B" Command="{Binding PressCommand}" CommandParameter="B"/>
                <Button Grid.Row="2" Grid.Column="2" Classes="calc scientific operator" Content="C" Command="{Binding PressCommand}" CommandParameter="C"/>
                <Button Grid.Row="2" Grid.Column="3" Classes="calc scientific operator" Content="D" Command="{Binding PressCommand}" CommandParameter="D"/>
                <Button Grid.Row="2" Grid.Column="4" Classes="calc scientific operator" Content="E" Command="{Binding PressCommand}" CommandParameter="E"/>

                <Button Grid.Row="3" Grid.Column="0" Classes="calc scientific operator" Content="F" Command="{Binding PressCommand}" CommandParameter="F"/>
                <Button Grid.Row="3" Grid.Column="1" Classes="calc scientific operator" Content="AND" Command="{Binding PressCommand}" CommandParameter="And"/>
                <Button Grid.Row="3" Grid.Column="2" Classes="calc scientific operator" Content="OR" Command="{Binding PressCommand}" CommandParameter="Or"/>
                <Button Grid.Row="3" Grid.Column="3" Classes="calc scientific operator" Content="XOR" Command="{Binding PressCommand}" CommandParameter="Xor"/>
                <Button Grid.Row="3" Grid.Column="4" Classes="calc scientific operator" Content="NOT" Command="{Binding PressCommand}" CommandParameter="Not"/>

                <Button Grid.Row="4" Grid.Column="0" Classes="calc scientific operator" Content="Lsh" Command="{Binding PressCommand}" CommandParameter="Lsh"/>
                <Button Grid.Row="4" Grid.Column="1" Classes="calc scientific digit" Content="7" Command="{Binding PressCommand}" CommandParameter="7"/>
                <Button Grid.Row="4" Grid.Column="2" Classes="calc scientific digit" Content="8" Command="{Binding PressCommand}" CommandParameter="8"/>
                <Button Grid.Row="4" Grid.Column="3" Classes="calc scientific digit" Content="9" Command="{Binding PressCommand}" CommandParameter="9"/>
                <Button Grid.Row="4" Grid.Column="4" Classes="calc scientific operator" Content="÷" Command="{Binding PressCommand}" CommandParameter="/"/>

                <Button Grid.Row="5" Grid.Column="0" Classes="calc scientific operator" Content="Rsh" Command="{Binding PressCommand}" CommandParameter="Rsh"/>
                <Button Grid.Row="5" Grid.Column="1" Classes="calc scientific digit" Content="4" Command="{Binding PressCommand}" CommandParameter="4"/>
                <Button Grid.Row="5" Grid.Column="2" Classes="calc scientific digit" Content="5" Command="{Binding PressCommand}" CommandParameter="5"/>
                <Button Grid.Row="5" Grid.Column="3" Classes="calc scientific digit" Content="6" Command="{Binding PressCommand}" CommandParameter="6"/>
                <Button Grid.Row="5" Grid.Column="4" Classes="calc scientific operator" Content="×" Command="{Binding PressCommand}" CommandParameter="*"/>

                <Button Grid.Row="6" Grid.Column="0" Classes="calc scientific operator" Content="Mod" Command="{Binding PressCommand}" CommandParameter="Mod"/>
                <Button Grid.Row="6" Grid.Column="1" Classes="calc scientific digit" Content="1" Command="{Binding PressCommand}" CommandParameter="1"/>
                <Button Grid.Row="6" Grid.Column="2" Classes="calc scientific digit" Content="2" Command="{Binding PressCommand}" CommandParameter="2"/>
                <Button Grid.Row="6" Grid.Column="3" Classes="calc scientific digit" Content="3" Command="{Binding PressCommand}" CommandParameter="3"/>
                <Button Grid.Row="6" Grid.Column="4" Classes="calc scientific operator" Content="-" Command="{Binding PressCommand}" CommandParameter="-"/>

                <Button Grid.Row="7" Grid.Column="0" Classes="calc scientific operator" Content="CL" Command="{Binding PressCommand}" CommandParameter="Clear"/>
                <Button Grid.Row="7" Grid.Column="1" Classes="calc scientific digit" Content="0" Command="{Binding PressCommand}" CommandParameter="0"/>
                <Button Grid.Row="7" Grid.Column="2" Classes="calc scientific equals" Content="=" Command="{Binding PressCommand}" CommandParameter="="/>
                <Button Grid.Row="7" Grid.Column="3" Grid.ColumnSpan="2" Classes="calc scientific operator" Content="+" Command="{Binding PressCommand}" CommandParameter="+"/>
            </Grid>

            <Grid IsVisible="{Binding IsGraphing}" ColumnDefinitions="*,370" Margin="-12,0,-12,-4">
                <Grid>
                    <controls:GraphPlot Expressions="{Binding PlottedExpressions}"
                                        Variables="{Binding GraphVariablesText}"
                                        Zoom="{Binding GraphZoom}"
                                        Parameter="{Binding GraphParameter}"
                                        XMin="{Binding GraphXMin}"
                                        XMax="{Binding GraphXMax}"
                                        YMin="{Binding GraphYMin}"
                                        YMax="{Binding GraphYMax}"
                                        AngleUnit="{Binding AngleUnit}"
                                        LineThickness="{Binding GraphLineThickness}"/>
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,14,14">
                        <Button Classes="mode" Content="+" Command="{Binding ZoomGraphCommand}" CommandParameter="In" Margin="0,0,0,4"/>
                        <Button Classes="mode" Content="-" Command="{Binding ZoomGraphCommand}" CommandParameter="Out" Margin="0,0,0,4"/>
                        <Button Classes="mode" Content="⌾" Command="{Binding ZoomGraphCommand}" CommandParameter="Reset"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,10,14,0"
                                Background="#f6f6f6">
                        <Button Classes="mode" Content="▷"/>
                        <Button Classes="mode" Content="↗"/>
                        <Button Classes="mode" Content="⚙" Command="{Binding ToggleGraphOptionsCommand}"/>
                    </StackPanel>

                    <Border IsVisible="{Binding IsGraphOptionsOpen}"
                            Background="#f7f7f7"
                            BorderBrush="#d8d8d8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Width="320"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="18">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Graph options" FontSize="21" FontWeight="SemiBold"/>
                                <Button Grid.Column="1" Content="Reset view" Command="{Binding ResetGraphViewCommand}" Background="Transparent"/>
                            </Grid>

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="6">
                                <TextBlock Grid.Row="0" Text="X-Min" Foreground="#606060"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="X-Max" Foreground="#606060"/>
                                <TextBox Grid.Row="1" Text="{Binding GraphXMin}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GraphXMax}"/>
                                <TextBlock Grid.Row="2" Text="Y-Min" Foreground="#606060"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Y-Max" Foreground="#606060"/>
                                <TextBox Grid.Row="3" Text="{Binding GraphYMin}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GraphYMax}"/>
                            </Grid>

                            <TextBlock Text="Units" Foreground="#606060"/>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <Button Content="Radians" Command="{Binding SetAngleUnitCommand}" CommandParameter="Radians"/>
                                <Button Grid.Column="1" Content="Degrees" Command="{Binding SetAngleUnitCommand}" CommandParameter="Degrees"/>
                                <Button Grid.Column="2" Content="Gradians" Command="{Binding SetAngleUnitCommand}" CommandParameter="Gradians"/>
                            </Grid>

                            <TextBlock Text="Line thickness" Foreground="#606060"/>
                            <Slider Minimum="1" Maximum="6" Value="{Binding GraphLineThickness}"/>

                            <TextBlock Text="Graph theme" Foreground="#606060"/>
                            <RadioButton Content="Always light" IsChecked="True"/>
                            <RadioButton Content="Match app theme"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Background="#f3f3f3" Margin="4,0,0,0">
                    <StackPanel Margin="10,0,10,8" Spacing="4">
                        <Border Classes="panel">
                            <Grid ColumnDefinitions="38,*">
                                <Border Background="#0067c0" CornerRadius="4" Width="34" Height="44">
                                    <TextBlock Text="f₁" Foreground="White" FontSize="20" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetActiveGraphInputCommand}"
                                        CommandParameter="Primary"/>
                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="10,0,0,0">
                                    <TextBlock Text="y =" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding GraphExpression, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="15"
                                             BorderThickness="0"
                                             Background="Transparent"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Classes="panel" Opacity="0.72">
                            <Grid ColumnDefinitions="38,*">
                                <Border Background="#7a7a7a" CornerRadius="4" Width="34" Height="44">
                                    <TextBlock Text="f" Foreground="White" FontSize="20" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetActiveGraphInputCommand}"
                                        CommandParameter="Secondary"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding GraphExpression2, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="15"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         PlaceholderText="Enter an expression"
                                         Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding GraphVariables}" Margin="10,6,10,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:GraphVariable">
                                <Border Classes="panel" Margin="0,0,0,8">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto">
                                        <TextBlock Text="{Binding Name}" FontStyle="Italic" FontSize="18" VerticalAlignment="Center" Margin="8,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="=" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Value}"
                                                 HorizontalAlignment="Left"
                                                 Width="76"
                                                 BorderThickness="0"
                                                 Background="Transparent"/>
                                        <ToggleButton Grid.Column="3"
                                                      IsChecked="{Binding IsExpanded}"
                                                      Content="⌄"
                                                      Width="28"
                                                      Height="28"
                                                      HorizontalAlignment="Right"/>
                                        <Slider Grid.Row="1"
                                                Grid.ColumnSpan="4"
                                                Minimum="{Binding Minimum}"
                                                Maximum="{Binding Maximum}"
                                                TickFrequency="{Binding Step}"
                                                Value="{Binding Value}"
                                                Margin="8,6,8,0"/>
                                        <Grid Grid.Row="2" Grid.ColumnSpan="4" ColumnDefinitions="*,*,*" Margin="0,6,0,0" IsVisible="{Binding IsExpanded}">
                                            <TextBlock Text="Min" Foreground="#606060" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="Step" Foreground="#606060" FontSize="12"/>
                                            <TextBlock Grid.Column="2" Text="Max" Foreground="#606060" FontSize="12"/>
                                        </Grid>
                                        <Grid Grid.Row="3" Grid.ColumnSpan="4" ColumnDefinitions="*,*,*" ColumnSpacing="10" IsVisible="{Binding IsExpanded}">
                                            <TextBox Text="{Binding Minimum}" FontSize="13"/>
                                            <TextBox Grid.Column="1" Text="{Binding Step}" FontSize="13"/>
                                            <TextBox Grid.Column="2" Text="{Binding Maximum}" FontSize="13"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2" Background="#eeeeee"/>

                    <Grid Grid.Row="3" RowDefinitions="Auto,*,*,*,*,*,*" ColumnDefinitions="*,*,*,*,*" Margin="6">
                        <Grid Grid.Row="0" Grid.ColumnSpan="5" ColumnDefinitions="*,*,*" Margin="0,0,0,4">
                            <Button Grid.Column="0" Classes="mode" Content="△ Trigonometry"/>
                            <Button Grid.Column="1" Classes="mode" Content="□ Inequalities"/>
                            <Button Grid.Column="2" Classes="mode" Content="ƒ Function"/>
                        </Grid>

                        <Button Grid.Row="1" Grid.Column="0" Classes="calc graphKey operator" Content="2ⁿᵈ"/>
                        <Button Grid.Row="1" Grid.Column="1" Classes="calc graphKey operator" Content="π" Command="{Binding GraphKeyCommand}" CommandParameter="Pi"/>
                        <Button Grid.Row="1" Grid.Column="2" Classes="calc graphKey operator" Content="e" Command="{Binding GraphKeyCommand}" CommandParameter="e"/>
                        <Button Grid.Row="1" Grid.Column="3" Classes="calc graphKey operator" Content="C" Command="{Binding ClearGraphCommand}"/>
                        <Button Grid.Row="1" Grid.Column="4" Classes="calc graphKey operator" Content="⌫" Command="{Binding GraphKeyCommand}" CommandParameter="Back"/>

                        <Button Grid.Row="2" Grid.Column="0" Classes="calc graphKey operator" Content="x²" Command="{Binding GraphKeyCommand}" CommandParameter="Square"/>
                        <Button Grid.Row="2" Grid.Column="1" Classes="calc graphKey operator" Content="1/x" Command="{Binding GraphKeyCommand}" CommandParameter="1/x"/>
                        <Button Grid.Row="2" Grid.Column="2" Classes="calc graphKey operator" Content="|x|" Command="{Binding GraphKeyCommand}" CommandParameter="abs("/>
                        <Button Grid.Row="2" Grid.Column="3" Classes="calc graphKey operator" Content="x" Command="{Binding GraphKeyCommand}" CommandParameter="x"/>
                        <Button Grid.Row="2" Grid.Column="4" Classes="calc graphKey operator" Content="f" Command="{Binding GraphKeyCommand}" CommandParameter="f"/>

                        <Button Grid.Row="3" Grid.Column="0" Classes="calc graphKey operator" Content="√x" Command="{Binding GraphKeyCommand}" CommandParameter="Sqrt"/>
                        <Button Grid.Row="3" Grid.Column="1" Classes="calc graphKey operator" Content="(" Command="{Binding GraphKeyCommand}" CommandParameter="("/>
                        <Button Grid.Row="3" Grid.Column="2" Classes="calc graphKey operator" Content=")" Command="{Binding GraphKeyCommand}" CommandParameter=")"/>
                        <Button Grid.Row="3" Grid.Column="3" Classes="calc graphKey operator" Content="=" Command="{Binding PlotGraphCommand}"/>
                        <Button Grid.Row="3" Grid.Column="4" Classes="calc graphKey operator" Content="÷" Command="{Binding GraphKeyCommand}" CommandParameter="/"/>

                        <Button Grid.Row="4" Grid.Column="0" Classes="calc graphKey operator" Content="xʸ" Command="{Binding GraphKeyCommand}" CommandParameter="Power"/>
                        <Button Grid.Row="4" Grid.Column="1" Classes="calc graphKey digit" Content="7" Command="{Binding GraphKeyCommand}" CommandParameter="7"/>
                        <Button Grid.Row="4" Grid.Column="2" Classes="calc graphKey digit" Content="8" Command="{Binding GraphKeyCommand}" CommandParameter="8"/>
                        <Button Grid.Row="4" Grid.Column="3" Classes="calc graphKey digit" Content="9" Command="{Binding GraphKeyCommand}" CommandParameter="9"/>
                        <Button Grid.Row="4" Grid.Column="4" Classes="calc graphKey operator" Content="×" Command="{Binding GraphKeyCommand}" CommandParameter="*"/>

                        <Button Grid.Row="5" Grid.Column="0" Classes="calc graphKey operator" Content="10ˣ" Command="{Binding GraphKeyCommand}" CommandParameter="TenPow"/>
                        <Button Grid.Row="5" Grid.Column="1" Classes="calc graphKey digit" Content="4" Command="{Binding GraphKeyCommand}" CommandParameter="4"/>
                        <Button Grid.Row="5" Grid.Column="2" Classes="calc graphKey digit" Content="5" Command="{Binding GraphKeyCommand}" CommandParameter="5"/>
                        <Button Grid.Row="5" Grid.Column="3" Classes="calc graphKey digit" Content="6" Command="{Binding GraphKeyCommand}" CommandParameter="6"/>
                        <Button Grid.Row="5" Grid.Column="4" Classes="calc graphKey operator" Content="−" Command="{Binding GraphKeyCommand}" CommandParameter="-"/>

                        <Button Grid.Row="6" Grid.Column="0" Classes="calc graphKey operator" Content="log" Command="{Binding GraphKeyCommand}" CommandParameter="log("/>
                        <Button Grid.Row="6" Grid.Column="1" Classes="calc graphKey digit" Content="1" Command="{Binding GraphKeyCommand}" CommandParameter="1"/>
                        <Button Grid.Row="6" Grid.Column="2" Classes="calc graphKey digit" Content="2" Command="{Binding GraphKeyCommand}" CommandParameter="2"/>
                        <Button Grid.Row="6" Grid.Column="3" Classes="calc graphKey digit" Content="3" Command="{Binding GraphKeyCommand}" CommandParameter="3"/>
                        <Button Grid.Row="6" Grid.Column="4" Classes="calc graphKey operator" Content="+" Command="{Binding GraphKeyCommand}" CommandParameter="+"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   Text="{Binding Mode}"
                   Foreground="#707070"
                   HorizontalAlignment="Right"/>
    </Grid>

</Window>
